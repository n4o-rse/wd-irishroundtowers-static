  "datatype": "wikibase-item",
  "descriptions": {
    "ar": {
      "language": "ar",
      "value": "التقسيم الإداري للكنيسة التي ينتمي إليها هذا العنصر"
    },
    "ast": {
      "language": "ast",
      "value": "división alministrativa de la ilesia a la que pertenez l'elementu; usar P5607 pa otros tipos d'entidaes territoriales eclesiástiques"
    },
    "bar": {
      "language": "bar",
      "value": "kiachlicha Vawoitungsbeziak, wo des Subjekt dzugheat"
    },
    "be-tarask": {
      "language": "be-tarask",
      "value": "царкоўная адміністрацыйная адзінка царквы, да якой належыць элемэнт"
    },
    "ca": {
      "language": "ca",
      "value": "divisió administrativa de l’església a la qual pertany l’element; utilitzeu P5607 per a altres tipus d’entitats territorials eclesiàstiques"
    },
    "cs": {
      "language": "cs",
      "value": "administrativní jednotka církve, ke které subjekt náleží"
    },
    "de": {
      "language": "de",
      "value": "kirchlicher Verwaltungsbezirk, zu dem das Subjekt gehört"
    },
    "el": {
      "language": "el",
      "value": "διοικητική διαίρεση της εκκλησίας στο οποίο υπάγεται το αναφερόμενο αντικείμενο"
    },
    "en": {
      "language": "en",
      "value": "administrative division of the church to which the element belongs; use P5607 for other types of ecclesiastical territorial entities"
    },
    "en-ca": {
      "language": "en-ca",
      "value": "administrative division of the church to which the element belongs; use P5607 for other types of ecclesiastical territorial entities"
    },
    "en-gb": {
      "language": "en-gb",
      "value": "administrative division of the church to which the element belongs; use P5607 for other types of ecclesiastical territorial entities"
    },
    "es": {
      "language": "es",
      "value": "circunscripción territorial de la Iglesia católica a la cual pertenece el elemento"
    },
    "ext": {
      "language": "ext",
      "value": "jurición territorial dela Ilesia Católica ala que perteneci l'elementu"
    },
    "fi": {
      "language": "fi",
      "value": "kirkon hallinnollinen alue, johon kohde kuuluu; käytä P5607 muille kirkollisille alueyksiköille"
    },
    "fr": {
      "language": "fr",
      "value": "circonscription territoriale d'une Église à laquelle appartient l'élément"
    },
    "gl": {
      "language": "gl",
      "value": "circunscrición territorial da igrexa católica á que pertence o elemento"
    },
    "hsb": {
      "language": "hsb",
      "value": "cyrkwinski zarjadniski wobwod"
    },
    "hu": {
      "language": "hu",
      "value": "az az egyházkormányzati egység, amelyhez az elem tartozik; használd a P5607-et más típusú egyházi területi egységek esetében"
    },
    "ig": {
      "language": "ig",
      "value": "Nkewa nchịkwa nke ụka nke mmewere bụ nke ya; jiri P5607 maka ụdị ụlọ ụka ndị ọzọ"
    },
    "it": {
      "language": "it",
      "value": "divisione amministrativa della chiesa (cattolica o meno) a cui l'elemento appartiene"
    },
    "ko": {
      "language": "ko",
      "value": "항목 주제가 속해있는 교구"
    },
    "lv": {
      "language": "lv",
      "value": "baznīcas administratīvi teritoriāla vienība"
    },
    "nl": {
      "language": "nl",
      "value": "administratieve afdeling van de kerk waartoe het element behoort"
    },
    "pl": {
      "language": "pl",
      "value": "administratura, do której należy dany element"
    },
    "ro": {
      "language": "ro",
      "value": "diviziunea administrativă a bisericii din care face parte elementul; utilizați P5607 pentru alte tipuri de entități teritoriale ecleziastice"
    },
    "scn": {
      "language": "scn",
      "value": "diòcisi â quali apparteni stu suggettu"
    },
    "sv": {
      "language": "sv",
      "value": "administrativ enhet inom kyrkan"
    },
    "sw": {
      "language": "sw",
      "value": "mgawanyiko wa kiutawala wa kanisa ambalo sehemu yake ni; kumia P5607 kwa aina zingine za mashirika ya eneo la kikanisa"
    },
    "te": {
      "language": "te",
      "value": "బిషప్పు పర్యవేక్షణ పరిధిలోని ప్రాంతము"
    },
    "tr": {
      "language": "tr",
      "value": "unsurun ait olduğu kilisenin idari bölümü; diğer dini bölgesel varlık türleri için P5607'yi kullanın"
    },
    "uk": {
      "language": "uk",
      "value": "церковна адміністративна одиниця, до якої належить цей елемент"
    }
