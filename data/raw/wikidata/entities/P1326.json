  "datatype": "time",
  "descriptions": {
    "ast": {
      "language": "ast",
      "value": "fecha más tardía na que pudo asoceder daqué. Usar como calificador pa otres propiedaes de fecha"
    },
    "be": {
      "language": "be",
      "value": "найбольш позняя дата, калі нешта магло адбыцца. Ужываецца як кваліфікатар для іншых уласцівасцей са значэннем тыпу даты"
    },
    "be-tarask": {
      "language": "be-tarask",
      "value": "найпазьнейшая дата, калі магла адбыцца падзея. Для іншых уласьцівасьцяў даты карыстайцеся кваліфікатарамі"
    },
    "ca": {
      "language": "ca",
      "value": "data més tardana possible en la que alguna cosa podria haver ocorregut"
    },
