  "datatype": "wikibase-item",
  "descriptions": {
    "ast": {
      "language": "ast",
      "value": "destín previstu d'esta ruta (viaxe, vuelu, navegación, esploración, etc.)"
    },
    "be-tarask": {
      "language": "be-tarask",
      "value": "патрэбнае прызначэньне маршруту (шляху, кірунку)"
    },
    "ca": {
      "language": "ca",
      "value": "lloc on finalitza el viatge"
    },
    "cs": {
      "language": "cs",
      "value": "místo, kam směřuje nějaká cesta (let, jízda dopravního prostředku, výzkumná výprava, migrace atd.)"
    },
    "de": {
      "language": "de",
      "value": "Endpunkt dieser Reise, des Flugs, der Migration oder eines anderen Ereignisses"
    },
    "el": {
      "language": "el",
      "value": "ο επιδιωκόμενος προορισμός του ταξιδιού"
    },
    "en": {
      "language": "en",
      "value": "destination for this route (journey, flight, sailing, exploration, migration, etc.)"
    },
    "en-gb": {
      "language": "en-gb",
      "value": "intended destination for this route (journey, flight, sailing, exploration, migration, etc.)"
    },
    "es": {
      "language": "es",
      "value": "lugar de finalización de este viaje, vuelo, competición, etc."
    },
    "ext": {
      "language": "ext",
      "value": "lugal de términu d'esti viagi, vuelu o competición i mas"
    },
    "fa": {
      "language": "fa",
      "value": "مقصد هواپیما، خودرو، کشتی، الخ."
    },
    "fr": {
      "language": "fr",
      "value": "destination prévue du voyage, trajet, exploration..."
    },
    "gl": {
      "language": "gl",
      "value": "lugar de finalización dunha viaxe, ruta ou competición"
    },
    "ha": {
      "language": "ha",
      "value": "inda a kayi niyyar sauka dan wannan tafiya"
    },
    "he": {
      "language": "he",
      "value": "נקודת הסיום המיועדת"
    },
    "hr": {
      "language": "hr",
      "value": "planirano završno mjesto za ovo putovanje"
    },
    "hu": {
      "language": "hu",
      "value": "az utazás, repülőút, hajóút, felfedezőút stb. kitűzött célja"
    },
    "id": {
      "language": "id",
      "value": "tujuan dari suatu perjalanan, penerbangan, migrasi, penjelajahan, dan sebagainya"
    },
    "ig": {
      "language": "ig",
      "value": "ebe a na-aga maka ụzọ a (njem, ụgbọ elu, ịkwọ ụgbọ mmiri, ịgagharị, njem, wdg)"
    },
    "it": {
      "language": "it",
      "value": "destinazione di un viaggio, volo, crociera, esplorazione, eccetera"
    },
    "ja": {
      "language": "ja",
      "value": "航空便、航海などの当初意図されていた終点"
    },
    "ka": {
      "language": "ka",
      "value": "განსაზღვრული მარშრუტის დანიშნულების პუნქტი (მოგზაურობა, ფრენა, მიგრაცია და ა.შ.)"
    },
    "lb": {
      "language": "lb",
      "value": "Plaz wou eng Rees, e Fluch, e Pad, asw. ukënnt"
    },
    "mr": {
      "language": "mr",
      "value": "प्रवासामधील अखेरचे स्थान (रेल्वे स्थानक, विमानतळ इत्यादी)"
    },
    "nb": {
      "language": "nb",
      "value": "målet for en reise, flygning, ekspedisjon osv."
    },
    "nn": {
      "language": "nn",
      "value": "målet for ei reise, flyging, ekspedisjon osv."
    },
    "nqo": {
      "language": "nqo",
      "value": "ߡߐ߱߸ ߝߋ߲ ߥߟߌ߬ߣߍ߲߬ ߕߊ߯ ߞߊ߲ߡߊ߬ ߦߙߐ ߡߍ߲"
    },
    "pl": {
      "language": "pl",
      "value": "punkt końcowy danej podróży, lotu, rejsu, itd."
    },
    "ro": {
      "language": "ro",
      "value": "destinația pentru această rută (călătorie, zbor, traversare maritimă, expediție, migrație etc.)"
    },
    "ru": {
      "language": "ru",
      "value": "точка назначения определённого маршрута (путешествия, полёта, плавания, экспедиции и пр.) или конечная точка линейного (одномерного) объекта"
    },
    "sat": {
      "language": "sat",
      "value": "ᱡᱟᱦᱟᱸ ᱴᱷᱟᱶ ᱞᱟᱹᱜᱤᱫ ᱛᱮᱢ ᱪᱟᱞᱟᱜ ᱠᱟᱱᱟ"
    },
    "sv": {
      "language": "sv",
      "value": "den avsedda destinationen med resan, flygningen, seglatsen etc."
    },
