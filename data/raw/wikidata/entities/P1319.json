  "datatype": "time",
  "descriptions": {
    "ast": {
      "language": "ast",
      "value": "fecha más temprana na que pudo asoceder daqué. Usar como calificador pa otres propiedaes de fecha"
    },
    "be": {
      "language": "be",
      "value": "найбольш ранняя дата, калі нешта магло адбыцца. Ужываецца як кваліфікатар для іншых уласцівасцей са значэннем тыпу даты"
    },
    "be-tarask": {
      "language": "be-tarask",
      "value": "найранейшая дата, калі магла адбыцца падзея. Для іншых уласьцівасьцяў даты карыстайцеся кваліфікатарамі"
    },
    "bg": {
      "language": "bg",
      "value": "най-ранната дата, на която дадено събитие може да се е случило"
    },
    "ca": {
      "language": "ca",
      "value": "data més antiga a la qual podria haver-hi ocorregut un esdeveniment. Feu-lo servir com a qualificador per a altres propietats de dates"
    },
    "ce": {
      "language": "ce",
      "value": "хилам хила таро йолу уггаре хьалхара терахь"
    },
    "cs": {
      "language": "cs",
      "value": "nejdřívější možné datum, kdy mohlo dojít k příslušné události; používejte jako vymezení u jiných hodnot typu bod v čase"
    },
    "de": {
      "language": "de",
      "value": "frühestmöglicher Zeitpunkt, zu dem etwas stattgefunden haben könnte (möglicher Zeitpunkt liegt danach)"
    },
    "el": {
      "language": "el",
      "value": "η νωρίτερη ημερομηνία που ένα γεγονός μπορεί να είχε συμβεί"
    },
