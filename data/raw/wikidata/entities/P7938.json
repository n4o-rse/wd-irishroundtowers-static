  "datatype": "wikibase-item",
  "descriptions": {
    "bn": {
      "language": "bn",
      "value": "নির্বাচনী এলাকা যেখানে একটি স্থান অবস্থিত বা এর অংশ। যদি একটি পৌরসভা/কাউন্টি বিভিন্ন জেলায় বা অংশে বিভক্ত হয়: বেশ কয়েকটি মান যোগ করুন।  পূর্বনির্ধারিত দেশে প্রশাসনিক সত্তা (P131) থেকে আলাদা হলেই ব্যবহার করুন"
    },
    "ca": {
      "language": "ca",
      "value": "districtes electorals als quals pertany el lloc"
    },
    "el": {
      "language": "el",
      "value": "εκλογικές περιφέρειες στις οποίες ανήκει η τοποθεσία. Εάν ένας δήμος ή νομός χωρίζεται σε πολλές εκλογικές περιφέρειες ή αποτελεί μέρος πολλών περιφερειών, προσθέστε πολλές τιμές."
    },
    "en": {
      "language": "en",
      "value": "constituencies/electoral districts in which a place is located or is part of. If a municipality/county is split into or part of several districts: add several values. Use only if distinct from administrative entities (P131) in predefined countries"
    },
    "eo": {
      "language": "eo",
      "value": "administra unuo por ŝtataj balotoj"
    },
