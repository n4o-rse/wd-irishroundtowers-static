  "datatype": "commonsMedia",
  "descriptions": {
    "ca": {
      "language": "ca",
      "value": "vista de l'entrada o accés a l'estructura arquitectònica, vehicle o un altre espai que representa l'item"
    },
    "cs": {
      "language": "cs",
      "value": "zobrazení vstupu do této stavby, vozidla, oblasti atp. ve směru vstupu (nikoli výstupu)"
    },
    "dag": {
      "language": "dag",
      "value": "soli bee dundoli zaŋ ti yaɣa kpɛbu bee loori kpɛbu"
    },
    "de": {
      "language": "de",
      "value": "Blick auf einen Eintrittspunkt einer architektonischen Struktur, eines Fahrzeugs, einer Gebietskörperschaft, einer Straße oder eines anderen Raums in Einfahrtsrichtung (nicht in Ausfahrtsrichtung)"
    },
    "el": {
      "language": "el",
      "value": "άποψη του σημείου εισόδου ενός αντικειμένου (κτίσματος, οχήματος, δρόμου ή περιοχής), προς την κατεύθυνση εισόδου (όχι προς την έξοδο δηλαδή)"
    },
    "en": {
      "language": "en",
      "value": "view of an entry point of an architectural structure, vehicle, territorial entity, road or other space, in the entering direction (not in the exiting direction)"
    },
    "es": {
      "language": "es",
      "value": "vista de un punto de entrada de una estructura arquitectónica, vehículo, frontera, carretera o otro espacio, en dirección a la entrada (no en dirección de salida)"
    },
    "fa": {
      "language": "fa",
      "value": "نمای یک نقطهٔ ورودی یک سازهٔ معماری، وسیلهٔ نقلیه، موجودیت سرزمینی، جاده یا فضاهای دیگر، در جهت ورودی (نه در جهت خروجی)"
    },
    "fr": {
      "language": "fr",
      "value": "vue d'un point d'accès d'une structure architecturale, d'un véhicule, d'une entité territoriale, d'une route ou d'un autre espace dans la direction d'entrée (pas la direction de sortie)"
    },
    "hsb": {
      "language": "hsb",
      "value": "napohlad zachoda architektoniskeje struktury, jězdźidła, dróhi abo rumnosće"
    },
    "it": {
      "language": "it",
      "value": "immagine che ritrae l'entrata in una struttura architettonica, un veicolo, un'entità territoriale, etc,, nella direzione di entrata (e non di uscita)"
    },
    "ja": {
      "language": "ja",
      "value": "建造物、乗り物などの入り口の入る方向の画像"
    },
    "ko": {
      "language": "ko",
      "value": "건물, 차량, 영토, 도로 또는 기타 공간의 진입 구역의 사진 (나가는 곳 제외)"
    },
    "lb": {
      "language": "lb",
      "value": "Bléck op d'Entrée vun enger architektonescher Struktur, enger Strooss, engem Gefier, asw."
    },
    "nl": {
      "language": "nl",
      "value": "een afbeelding van de entree of ingang van het item"
    },
    "pl": {
      "language": "pl",
      "value": "widok na punkt wejścia do budynku, pojazdu, terytorium lub innej przestrzeni, w kierunku wejścia (z zewnątrz)"
    },
    "pt": {
      "language": "pt",
      "value": "vista de um ponto de entrada de uma estrutura arquitetônica, veículo, entidade territorial, estrada ou outro espaço, na direção de entrada (não na direção de saída)"
    },
    "pt-br": {
      "language": "pt-br",
      "value": "vista de um ponto de entrada de uma estrutura arquitetônica, veículo, entidade territorial, estrada ou outro espaço, na direção de entrada (não na direção de saída)"
    },
    "ru": {
      "language": "ru",
      "value": "изображение места входа в архитектурное сооружение, транспортное средство, участок земли, дорогу или любое другое пространство, наблюдаемое снаружи (не изнутри)"
    },
    "sv": {
      "language": "sv",
      "value": "vy över accesspunkten till en arkitektonisk struktur, fordon, territoriell enhet, väg eller annat utrymme i ingångsriktningen (ej bild på utgång)"
    },
    "uk": {
      "language": "uk",
      "value": "вид вхідної групи в архітектурну споруду, транспортний засіб, територіальну одиницю, дорогу чи інший простір у напрямку входу (не у напрямку виходу)"
    },
    "zh": {
      "language": "zh",
      "value": "建築結構、車輛、領土實體、道路或其他空間的入口點在進入方向（而非離開方向）的樣子"
    },
    "zh-hant": {
      "language": "zh-hant",
      "value": "建築結構、車輛、領土實體、道路或其他空間的入口點在進入方向（而非離開方向）的樣子"
    },
    "zh-tw": {
      "language": "zh-tw",
      "value": "建築結構、車輛、領土實體、道路或其他空間的入口點在進入方向（而非離開方向）的樣子"
    }
  },
