  "datatype": "wikibase-item",
  "descriptions": {
    "de": {
      "language": "de",
      "value": "thematische Einheit eines narrativen oder literarischen Werks, das zur Entwicklung eines Themas, der Stimmung oder Handlung beiträgt"
    },
    "en": {
      "language": "en",
      "value": "thematic unit in a narrative or literary work used to develop a theme, mood or plot"
    },
    "es": {
      "language": "es",
      "value": "unidad temática en una narrativa o trabajo literario utilizado para desarrollar un tema, estado de ánimo o trama"
    },
    "fr": {
      "language": "fr",
      "value": "unité thématique dans un récit ou une œuvre littéraire utilisée pour développer un thème, une ambiance ou une intrigue"
    },
    "hy": {
      "language": "hy",
      "value": "պատմողական կամ գրական ստեղծագործության թեմատիկ միավոր, որն օգտագործվում է թեմա, տրամադրություն կամ սյուժե զարգացնելու համար"
    },
    "ja": {
      "language": "ja",
      "value": "主題や雰囲気、プロットを展開するために用いる物語または文学作品の主題の単位"
    },
    "ko": {
      "language": "ko",
      "value": "줄거리나 분위기 혹은 주제 등을 만들기 위해 사용되는 문학적 장치 혹은 단위"
    },
    "pl": {
      "language": "pl",
      "value": "jednostka tematyczna w utworze, mająca wytworzyć motyw, nastrój lub fabułę"
    },
    "ro": {
      "language": "ro",
      "value": "unitate tematică dintr-o narațiune sau operă literară folosită pentru a dezvolta o temă, o stare de spirit sau o intrigă"
    },
    "tr": {
      "language": "tr",
      "value": "bir tema, ruh hali veya olay örgüsü geliştirmek için kullanılan bir anlatı ya da edebi çalışmadaki tematik birim"
    },
    "uk": {
      "language": "uk",
      "value": "тематична одиниця в оповіді або літературній роботі, яка використовується для розробки теми, настрою або сюжету"
    },
    "zh": {
      "language": "zh",
      "value": "叙事或文学作品中用于发展主题、营造氛围或推动情节的专题单元"
    }
  },
