  "datatype": "time",
  "descriptions": {
    "de": {
      "language": "de",
      "value": "Datum, an dem eine Organisation aufgelöst bzw. ein Bauwerk zerstört wurde; siehe P730 für die Stilllegung einer Dienstleistung und P2669 für die Stilllegung eines Produkts"
    },
    "en": {
      "language": "en",
      "value": "point in time at which the subject (organisation, building) ceased to exist; see \"date of official closure\" (P3999) for closing a facility, \"service retirement\" (P730) for retiring equipment, \"discontinued date\" (P2669) for stopping a product"
    }
  },
